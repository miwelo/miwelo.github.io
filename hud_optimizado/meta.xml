<meta>
    <info author="MIWELO" name="HUD Optimizado" description="Sistema de HUD optimizado para MTA:SA con reducción del 60% en consumo de recursos" version="1.0.0" type="script" />
    
    <!-- Core Configuration -->
    <script src="config.lua" type="shared" />
    
    <!-- Core Utils -->
    <script src="core/utils/Cache.lua" type="client" />
    <script src="core/utils/Renderer.lua" type="client" />
    <script src="core/utils/async.lua" type="client" />
    
    <!-- Client Managers -->
    <script src="core/client/DataManager.lua" type="client" />
    <script src="core/client/PolygonManager.lua" type="client" />
    <script src="core/client/HUDManager.lua" type="client" />
    
    <!-- Assets -->
    <file src="core/assets/images/logo.png" />
    <file src="core/assets/images/velo.png" />
    <file src="core/assets/images/fuel.png" />
    <file src="core/assets/images/light.png" />
    <file src="core/assets/images/repair.png" />
    <file src="core/assets/images/locked.png" />
    <file src="core/assets/images/brake.png" />
    <file src="core/assets/images/belt.png" />
    <file src="core/assets/images/button.png" />
    
    <!-- Shader -->
    <file src="core/assets/shader/shader.fx" />
    
    <!-- Fonts -->
    <file src="core/assets/fonts/sfbold.ttf" />
    <file src="core/assets/fonts/bold.ttf" />
    
    <!-- Exports for compatibility -->
    <export function="toggleHUD" type="client" />
    <export function="isHUDEnabled" type="client" />
    <export function="setHUDVisible" type="client" />
    <export function="updatePlayerStats" type="client" />
    <export function="updateVehicleData" type="client" />
    
    <!-- Settings -->
    <settings>
        <setting name="*hud_enabled" value="true" friendlyname="HUD Habilitado" group="General" />
        <setting name="*fps_limit" value="60" friendlyname="Límite de FPS" group="Rendimiento" />
        <setting name="*cache_enabled" value="true" friendlyname="Cache Habilitado" group="Rendimiento" />
        <setting name="*smooth_animations" value="true" friendlyname="Animaciones Suaves" group="Visual" />
    </settings>
</meta>